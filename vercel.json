{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/routeur.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdf-parse/node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/confirm-livraison",
      "destination": "/api/routeur?__route=confirm-livraison"
    },
    {
      "source": "/api/declarer-perte",
      "destination": "/api/routeur?__route=declarer-perte"
    },
    {
      "source": "/api/envoyer-commande-appro",
      "destination": "/api/routeur?__route=envoyer-commande-appro"
    },
    {
      "source": "/api/envoyer-tracabilite-lidl",
      "destination": "/api/routeur?__route=envoyer-tracabilite-lidl"
    },
    {
      "source": "/api/messagerie",
      "destination": "/api/routeur?__route=messagerie"
    },
    {
      "source": "/api/nlt-bl-backfill",
      "destination": "/api/routeur?__route=nlt-bl-backfill"
    },
    {
      "source": "/api/nlt-bl-poll",
      "destination": "/api/routeur?__route=nlt-bl-poll"
    },
    {
      "source": "/api/pointeuse-pointer",
      "destination": "/api/routeur?__route=pointeuse-pointer"
    },
    {
      "source": "/api/portail-reconditionneur",
      "destination": "/api/routeur?__route=portail-reconditionneur"
    },
    {
      "source": "/api/push-envoyer",
      "destination": "/api/routeur?__route=push-envoyer"
    },
    {
      "source": "/api/recap-reconditionnement",
      "destination": "/api/routeur?__route=recap-reconditionnement"
    },
    {
      "source": "/api/scan-etiquette",
      "destination": "/api/routeur?__route=scan-etiquette"
    },
    {
      "source": "/api/sante-comptes-mail",
      "destination": "/api/routeur?__route=sante-comptes-mail"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/routeur?__route=send-email"
    },
    {
      "source": "/api/upload-photo",
      "destination": "/api/routeur?__route=upload-photo"
    },
    {
      "source": "/api/verifier-base",
      "destination": "/api/routeur?__route=verifier-base"
    }
  ]
}
