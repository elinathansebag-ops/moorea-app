{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/send-email.js": {
      "maxDuration": 30
    },
    "api/recap-reconditionnement.js": {
      "maxDuration": 60
    },
    "api/nlt-bl-poll.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdf-parse/node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
    },
    "api/messagerie.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/push-envoyer",
      "destination": "/api/sante-comptes-mail?__route=push-envoyer"
    },
    {
      "source": "/api/nlt-bl-backfill",
      "destination": "/api/nlt-bl-poll?__route=nlt-bl-backfill"
    },
    {
      "source": "/api/envoyer-tracabilite-lidl",
      "destination": "/api/envoyer-commande-appro?__route=envoyer-tracabilite-lidl"
    }
  ]
}
